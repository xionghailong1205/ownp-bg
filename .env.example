# 环境变量配置示例文件
# 请将此文件复制为 .env 并填入实际配置值
# cp .env.example .env

# PostgreSQL 数据库配置
# 数据库用户名
POSTGRES_USER=ownp
# 数据库密码（请修改为强密码，例如：使用 openssl rand -base64 32 生成随机密码）
POSTGRES_PASSWORD=your_secure_password_here
# 数据库名称
POSTGRES_DB=ownp_db

# 应用运行环境: development | production
APP_ENV=development
# 服务监听地址
SERVER_ADDR=:8080
# 开发环境数据库连接串
DATABASE_URL_DEV=postgres://ownp:your_secure_password_here@localhost:5432/ownp_db?sslmode=disable
# 生产环境数据库连接串（示例，请替换为真实生产配置）
DATABASE_URL_PROD=postgres://ownp:your_secure_password_here@postgres:5432/ownp_db?sslmode=require
